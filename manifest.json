{
  "manifest_version": 3,
  "name": "Tab & Tick",
  "version": "1.0.1",
  "description": "A fast to-do list in your new tab. Works with Google Tasks.",
  "key": "",
  "minimum_chrome_version": "105",
  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },
  "chrome_url_overrides": {
    "newtab": "index.html"
  },
  "permissions": [
    "identity"
  ],
  "host_permissions": [
    "https://tasks.googleapis.com/*"
  ],
  "oauth2": {
    "client_id": "719894949389-2guc04s1s6ss2n1tuh29tau4lsca84cl.apps.googleusercontent.com",
    "scopes": [
      "https://www.googleapis.com/auth/tasks"
    ]
  }
}
